#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

#define MAX_NAME 50
#define MAX_ITEMS 5

typedef struct {
    int id;
    char nama[MAX_NAME];
    int jumlah_barang;
    float harga;
    float diskon;
} Item;

void buatTabel(Item items[], int n) {
    printf("Selamat Datang di Toko Skensa\n");
    printf("Silahkan Pilih Barang yang Anda Inginkan :\n");
    printf("\n");
    printf("==========================================\n");
    printf("| No. | Nama Barang      | Harga         |\n");
    printf("==========================================\n");
    for (int i = 0; i < n; i++) {
        printf("| %-3d | %-15s  | Rp.%-10.0f  |\n", items[i].id, items[i].nama, items[i].harga);
    }
    printf("==========================================\n");
    printf("99 Struk Pembayaran\n");
    printf("55 Reset Pilihan\n");
    printf("00 Keluar\n");
    printf("==========================================\n");
}

float hitungDiskon(int jumlah_barang, float harga) {
    if (jumlah_barang > 5) return 0.15 * harga * jumlah_barang;
    else if (jumlah_barang > 3) return 0.10 * harga * jumlah_barang;
    return 0;
}

void urutkanBarang(Item items[], int n) {
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - i - 1; j++) {
            if (items[j].jumlah_barang < items[j + 1].jumlah_barang) {
                Item temp = items[j];
                items[j] = items[j + 1];
                items[j + 1] = temp;
            }
        }
    }
}

void tampilkanTransaksi(Item items[], int n, int totalHarga, int totalDiskon, int totalBayar) {
    urutkanBarang(items, n);
    printf("\n");
    printf("=======================================================================\n");
    printf("                            REKAP PESANAN BARANG                      \n");
    printf("=======================================================================\n");
    printf("| No. | Jumlah | Nama Barang      | Harga    | Total Harga | Diskon   |\n");
    printf("-----------------------------------------------------------------------\n");

    for (int i = 0; i < n; i++) {
        if (items[i].jumlah_barang > 0) {
            float total = items[i].jumlah_barang * items[i].harga;
            float diskon = hitungDiskon(items[i].jumlah_barang, items[i].harga);
            printf("| %-3d | %-6d | %-15s | Rp%-6.0f | Rp%-10.0f | Rp%-6.0f |\n",
                   i + 1, items[i].jumlah_barang, items[i].nama, items[i].harga, total, diskon);
        }
    }

    printf("-----------------------------------------------------------------------\n");
    printf("| Total Harga  = Rp.%-10d  |\n", totalHarga);
    printf("| Total Diskon = Rp.%-10d  |\n", totalDiskon);
    printf("| Total Bayar  = Rp.%-10d  |\n", totalBayar);
    printf("=======================================================================\n");
}

void buatStruk(Item items[], int n, int totalHarga, int totalDiskon, int totalBayar, int bayar) {
    time_t t = time(NULL);
    struct tm tm = *localtime(&t);
    char filename[50];

    snprintf(filename, sizeof(filename), "%d%02d%02d%02d%02d%02d.txt",
             tm.tm_year + 1900, tm.tm_mon + 1, tm.tm_mday, tm.tm_hour, tm.tm_min, tm.tm_sec);

    FILE *file = fopen(filename, "w");
    if (file == NULL) {
        printf("Gagal Menyimpan File!\n");
        return;
    }

    fprintf(file, "-----------------------------------------------------\n");
    fprintf(file, "|                   Toko SKENSA                     |\n");
    fprintf(file, "|      Jl. HOS Cokroaminoto No. 84, Denpasar        |\n");
    fprintf(file, "|                      Bali                         |\n");
    fprintf(file, "|               Telp : 0816285791                   |\n");
    fprintf(file, "-----------------------------------------------------\n");

    fprintf(file, "| ID Struk: %d%02d%02d%02d%02d%02d                    |\n",
            tm.tm_year + 1900, tm.tm_mon + 1, tm.tm_mday, tm.tm_hour, tm.tm_min, tm.tm_sec);
    fprintf(file, "-----------------------------------------------------\n");

    fprintf(file, "| Nama Barang       | Harga   | Total   | Diskon   |\n");
    fprintf(file, "-----------------------------------------------------\n");

    urutkanBarang(items, n);

    for (int i = 0; i < n; i++) {
        if (items[i].jumlah_barang > 0) {
            float total = items[i].jumlah_barang * items[i].harga;
            float totalDiskonPerBarang = hitungDiskon(items[i].jumlah_barang, items[i].harga);
            fprintf(file, "| %2dx %-13s | Rp.%-5.0f | Rp.%-5.0f | Rp.%-5.0f  |\n",
                    items[i].jumlah_barang, items[i].nama, items[i].harga, total, totalDiskonPerBarang);
        }
    }
    fprintf(file, "-----------------------------------------------------\n");

    fprintf(file, "| Total Harga  = Rp.%-10d                   |\n", totalHarga);
    fprintf(file, "| Total Diskon = Rp.%-10d                   |\n", totalDiskon);
    fprintf(file, "| Tagihan      = Rp.%-10d                   |\n", totalBayar);
    fprintf(file, "| Pembayaran   = Rp.%-10d                   |\n", bayar);
    fprintf(file, "| Kembalian    = Rp.%-10d                   |\n", bayar - totalBayar);
    fprintf(file, "-----------------------------------------------------\n");

    fprintf(file, "| Waktu/Hari   : %s", asctime(&tm));
    fprintf(file, "-----------------------------------------------------\n");

    fclose(file);
    printf("Struk berhasil dicetak di %s\n", filename);
}


int main() {
    Item items[MAX_ITEMS] = {
        {1, "Buku Tulis", 0, 5000, 0},
        {2, "Pensil", 0, 2000, 0},
        {3, "Penghapus", 0, 1000, 0},
        {4, "Penggaris", 0, 1000, 0},
        {5, "Bujur Sangkar", 0, 500, 0},
    };

    Item items_awal[MAX_ITEMS];
    memcpy(items_awal, items, sizeof(items));

    int totalHarga, totalDiskon, totalBayar, bayar;
    int id, jumlah;

    while (1) {
        totalHarga = totalDiskon = totalBayar = 0;
        memcpy(items, items_awal, sizeof(items_awal));

        buatTabel(items, MAX_ITEMS);

        while (1) {
            printf("Input Pilihan yang Anda Inginkan: ");
            scanf("%d", &id);
            if (id == 00) return 0;
            if (id == 55) {
                for (int i = 0; i < MAX_ITEMS; i++) {
                    items[i].jumlah_barang = 0;
                }
                printf("Pilihan telah direset!\n");
                continue;
            }
            if (id == 99) {
                totalBayar = totalHarga - totalDiskon;
                tampilkanTransaksi(items, MAX_ITEMS, totalHarga, totalDiskon, totalBayar);
                break;
            }
            if (id < 1 || id > MAX_ITEMS) {
                printf("Input Tidak Valid!\n");
                continue;
            }
            printf("Masukan Jumlah %s: ", items[id - 1].nama);
            scanf("%d", &jumlah);
            items[id - 1].jumlah_barang += jumlah;
            totalHarga += items[id - 1].harga * jumlah;
            totalDiskon += hitungDiskon(items[id - 1].jumlah_barang, items[id - 1].harga);
        }

        printf("Masukan Uang Bayar: ");
        scanf("%d", &bayar);
        buatStruk(items, MAX_ITEMS, totalHarga, totalDiskon, totalBayar, bayar);
    }
    return 0;
}
