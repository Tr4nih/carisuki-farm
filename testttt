#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

#define MAX_NAME 50
#define MAX_ITEMS 5

typedef struct {
    int id;
    char nama[MAX_NAME];
    int jumlah_barang;
    float harga;
    float diskon;
} Item;

void buatTabel(Item items[], int n) {
    printf("==========================================\n");
    printf("| ID  | Nama Barang      | Harga         |\n");
    printf("==========================================\n");
    for (int i = 0; i < n; i++) {
        printf("| %-3d | %-15s  | Rp%-10.0f  |\n", items[i].id, items[i].nama, items[i].harga);
    }
    printf("==========================================\n");
}

float hitungDiskon(int jumlah_barang, float harga) {
    if (jumlah_barang >= 5) return 0.15 * harga * jumlah_barang;
    else if (jumlah_barang >= 3) return 0.10 * harga * jumlah_barang;
    return 0;
}

char *buatNamaFile() {
    time_t t = time(NULL);
    struct tm tm = *localtime(&t);
    static char filename[50];
    snprintf(filename, sizeof(filename), "%d%02d%02d%02d%02d%02d.txt",
             tm.tm_year + 1900, tm.tm_mon + 1, tm.tm_mday, tm.tm_hour, tm.tm_min, tm.tm_sec);
    return filename;
}

void buatStruk(Item items[], int hitung, int totalHarga, int totalDiskon, int totalBayar, int bayar) {
    char filename[50];
    strcpy(filename, buatNamaFile());
    FILE *file = fopen(filename, "w");

    if (file == NULL) {
        printf("GAGAL MENYIMPAN FILE!\n");
        return;
    }

    fprintf(file, "===========================================\n");
    fprintf(file, "|           WARUNG SKENSA           |\n");
    fprintf(file, "| JL HOS COKROAMINOTO NO. 84        |\n");
    fprintf(file, "===========================================\n");
    fprintf(file, "| Nama Barang   | Harga   | Jumlah | Total  | Diskon |\n");
    fprintf(file, "===========================================\n");

    for (int i = 0; i < hitung; i++) {
        if (items[i].jumlah_barang > 0) {
            float total = items[i].jumlah_barang * items[i].harga;
            fprintf(file, "| %-13s | Rp%-5.0f | %-6d | Rp%-5.0f | Rp%-5.0f |\n",
                    items[i].nama, items[i].harga, items[i].jumlah_barang, total, items[i].diskon);
        }
    }
    fprintf(file, "===========================================\n");
    fprintf(file, "| TOTAL HARGA  : Rp%-10d |\n", totalHarga);
    fprintf(file, "| TOTAL DISKON : Rp%-10d |\n", totalDiskon);
    fprintf(file, "| TOTAL TAGIHAN: Rp%-10d |\n", totalBayar);
    fprintf(file, "| BAYAR        : Rp%-10d |\n", bayar);
    fprintf(file, "| KEMBALIAN    : Rp%-10d |\n", bayar - totalBayar);
    fprintf(file, "===========================================\n");
    fclose(file);
    printf("Struk berhasil dicetak di %s\n", filename);
}

void tampilkanTransaksi(Item items[], int hitung, int totalHarga, int totalDiskon, int totalBayar) {
    printf("============ DAFTAR BELANJA ============\n");
    printf("========================================\n");
    printf("| Nama Barang   | Jumlah | Total Harga |\n");
    printf("========================================\n");

    for (int i = 0; i < hitung; i++) {
        if (items[i].jumlah_barang > 0) {
            printf("| %-13s | %-6d | Rp%-10.0f |\n", items[i].nama, items[i].jumlah_barang, items[i].harga * items[i].jumlah_barang);
        }
    }
    printf("========================================\n");
    printf("| TOTAL HARGA   : Rp%-10d |\n", totalHarga);
    printf("| TOTAL DISKON  : Rp%-10d |\n", totalDiskon);
    printf("| TOTAL TAGIHAN : Rp%-10d |\n", totalBayar);
    printf("========================================\n");
}

int main() {
    while (1) {
        Item items[MAX_ITEMS] = {
            {1, "BUKU", 0, 5000, 0},
            {2, "PENGGARIS", 0, 4000, 0},
            {3, "PULPEN", 0, 3000, 0},
            {4, "PENGHAPUS", 0, 2000, 0},
            {5, "PENSIL", 0, 1000, 0},
        };

        int totalHarga = 0, totalDiskon = 0, totalBayar = 0, bayar;
        int id, jumlah;

        buatTabel(items, MAX_ITEMS);

        while (1) {
            printf("MASUKAN ID BARANG (11 UNTUK CETAK STRUK, 99 UNTUK KELUAR): ");
            scanf("%d", &id);
            if (id == 99) return 0;
            if (id == 11) break;
            if (id < 1 || id > MAX_ITEMS) {
                printf("ID TIDAK VALID!\n");
                continue;
            }

            printf("MASUKAN JUMLAH %s: ", items[id - 1].nama);
            scanf("%d", &jumlah);
            items[id - 1].jumlah_barang += jumlah;
            float diskon = hitungDiskon(jumlah, items[id - 1].harga);
            items[id - 1].diskon += diskon;
            totalHarga += items[id - 1].harga * jumlah;
            totalDiskon += diskon;
        }

        totalBayar = totalHarga - totalDiskon;
        tampilkanTransaksi(items, MAX_ITEMS, totalHarga, totalDiskon, totalBayar);

        printf("MASUKAN UANG DIBAYARKAN: ");
        scanf("%d", &bayar);
        while (bayar < totalBayar) {
            printf("UANG KURANG! MASUKAN KEMBALI: ");
            scanf("%d", &bayar);
        }

        buatStruk(items, MAX_ITEMS, totalHarga, totalDiskon, totalBayar, bayar);
    }
    return 0;
}
